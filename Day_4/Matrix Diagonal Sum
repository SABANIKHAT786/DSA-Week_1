static int matrix(int[][] mat) {
    int sum = 0;
    for(int i = 0; i < mat.length; i++) {
        for(int j = 0; j < mat[i].length; j++) {
            if(i == j) {
                sum += mat[i][j];
            }
        }
    }
    for(int i = 0; i < mat.length; i++) {
        for(int j = 0; j < mat[i].length; j++) {
            if(i + j == mat.length - 1) {
                sum += mat[i][j];
            }
        }
    }
    if(mat.length % 2 == 1) {
        sum -= mat[mat.length / 2][mat.length / 2];
    }

    return sum;
}
